HOST=0.0.0.0
PORT=8787

STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# For your own coturn server, use a shared secret and leave TURN_USERNAME and TURN_CREDENTIAL unset.
TURN_SHARED_SECRET=replace-with-a-long-random-secret

# For a hosted TURN provider, use the static username and credential supplied by that provider
# and leave TURN_SHARED_SECRET unset.
# TURN_USERNAME=provider-username
# TURN_CREDENTIAL=provider-password

# Use relay only while performing the mandatory TURN fallback test.
RTC_ICE_TRANSPORT_POLICY=all
